class Solution {
  public:
  bool isValid(string s) {
        if(s.size() > 1 && s[0] == '0') return false;
        int num = stoi(s);
        return num >= 0 && num <= 255;
    }
    
    void solve(string &s, int index, int parts, string curr, vector<string> &res) {
        
        if(parts == 4 && index == s.size()) {
            curr.pop_back();
            res.push_back(curr);
            return;
        }
        
        if(parts >= 4) return;
        
        for(int len = 1; len <= 3 && index + len <= s.size(); len++) {
            
            string segment = s.substr(index, len);
            
            if(isValid(segment)) {
                solve(s, index + len, parts + 1, curr + segment + ".", res);
            }
        }
    }
    vector<string> generateIp(string &s) {
        // code here
        vector<string> res;
        
        if(s.size() < 4 || s.size() > 12)
            return res;
        
        solve(s, 0, 0, "", res);
        
        return res;
    }
};
