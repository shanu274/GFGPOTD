class Solution {
  public:
    int minCost(vector<int>& heights, vector<int>& cost) {
        int n = heights.size();
    vector<pair<int, int>> towers;
    for (int i = 0; i < n; i++) {
        towers.push_back({heights[i], cost[i]});
    }
    sort(towers.begin(), towers.end());
    
    long long totalWeight = 0;
    for (int c : cost)
        totalWeight += c;
    
    long long cumulativeWeight = 0;
    int medianHeight = 0;
    
    for (int i = 0; i < n; i++) {
        cumulativeWeight += towers[i].second;
        if (cumulativeWeight >= totalWeight / 2.0) {
            medianHeight = towers[i].first;
            break;
        }
    }
    long long totalCost = 0;
    for (int i = 0; i < n; i++) {
        totalCost += 1LL * abs(towers[i].first - medianHeight) * towers[i].second;
    }
    
    return totalCost;
    }
};
