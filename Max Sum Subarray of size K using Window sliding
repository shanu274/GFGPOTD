class Solution {
  public:
    int maxSubarraySum(vector<int>& arr, int k) {
        // code here
        int n = arr.size();
        
        if(n<k) return 0;
        
        int sum = 0;
        int maxSum = 0;
        
        for(int i = 0; i < k; i++){
            sum += arr[i];
            
        }
            
        maxSum = sum;
        for(int i = k; i < n; i++){
            sum += arr[i] - arr[i - k];
            maxSum = max(maxSum, sum);
        }
        return maxSum;
        
    }
};
