class Solution {
  public:
    int kokoEat(vector<int>& arr, int k) {
        // Code here
        int low = 1; 
        int high = *max_element(arr.begin(), arr.end());
        int ans = high;
        while(low <= high){
            int mid = (low + high) / 2;
            long long hrs = 0;
            
            for(int bananas : arr){
                hrs += (bananas + mid -1) / mid;
            }
            
            if(hrs <= k){
                ans = mid;
                high = mid - 1;
            }else{
                low = mid + 1;
            }
        }
        return ans;
    }
};
